<%
    const formatMoney = (value) => {
        return Number(value || 0).toLocaleString("en-GB", {
            style: "currency",
            currency: "GBP"
        });
    };

    const formatDate = (dateValue) => {
        if (!dateValue) {
            return "No date set";
        }

        return new Date(`${dateValue}T00:00:00`).toLocaleDateString(
            "en-GB",
            {
                day: "numeric",
                month: "short",
                year: "numeric"
            }
        );
    };

    const totalSavings = savingsGoals.reduce(
        (total, goal) => {
            return total + Number(goal.current_amount || 0);
        },
        0
    );

    const totalSavingsTarget = savingsGoals.reduce(
        (total, goal) => {
            return total + Number(goal.target_amount || 0);
        },
        0
    );

    const savingsPercentage =
        totalSavingsTarget > 0
            ? Math.min(
                Math.round(
                    (totalSavings / totalSavingsTarget) * 100
                ),
                100
            )
            : 0;
%>

<%- include("partials/header") %>

<!-- ================= INTRO SCREEN ================= -->

<div class="intro-screen" id="introScreen">
    <div class="intro-background-glow"></div>

    <div class="intro-content">
        <div class="intro-logo-wrapper">
            <img
                src="/images/logo-round.png"
                alt="MoneyMap logo"
                class="intro-logo"
            >

            <div class="intro-shimmer"></div>
        </div>

        <div class="intro-brand">
            <h1>MoneyMap</h1>

            <p>
                Plan Today. Build Tomorrow.
            </p>

            <div class="intro-line"></div>
        </div>
    </div>

    <div class="intro-ripple"></div>
</div>

<%- include("partials/navigation") %>

<!-- ================= DASHBOARD ================= -->

<main class="page-container">

    <!-- DASHBOARD HEADING -->

    <section class="dashboard-heading">
        <div>
            <p class="section-label">
                Financial Overview
            </p>

            <h1>
                Your MoneyMap
            </h1>

            <p>
                Track your balance, monthly activity, upcoming
                commitments and savings progress in one place.
            </p>
        </div>

        <a
            href="/transactions"
            class="primary-button"
        >
            Add Transaction
        </a>
    </section>

    <!-- QUICK ACTIONS -->

<section
    class="quick-actions"
    aria-label="MoneyMap quick actions"
>
    <a
        href="/transactions"
        class="quick-action"
    >
        <span class="quick-action-icon" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
            >
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
            </svg>
        </span>

        <span class="quick-action-content">
            <strong>Add Transaction</strong>
            <span>Record income or spending</span>
        </span>
    </a>

    <a
        href="/transactions"
        class="quick-action"
    >
        <span class="quick-action-icon" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M8 6h12"></path>
                <path d="M8 12h12"></path>
                <path d="M8 18h12"></path>
                <path d="M4 6h.01"></path>
                <path d="M4 12h.01"></path>
                <path d="M4 18h.01"></path>
            </svg>
        </span>

        <span class="quick-action-content">
            <strong>Transactions</strong>
            <span>Review your financial activity</span>
        </span>
    </a>

    <a
        href="/payments"
        class="quick-action"
    >
        <span class="quick-action-icon" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                <path d="M16 3v4"></path>
                <path d="M8 3v4"></path>
                <path d="M3 10h18"></path>
            </svg>
        </span>

        <span class="quick-action-content">
            <strong>Payments</strong>
            <span>Manage bills and subscriptions</span>
        </span>
    </a>

    <a
        href="/savings"
        class="quick-action"
    >
        <span class="quick-action-icon" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="5"></circle>
                <circle cx="12" cy="12" r="1"></circle>
            </svg>
        </span>

        <span class="quick-action-content">
            <strong>Savings</strong>
            <span>Track your financial goals</span>
        </span>
    </a>
</section>
    <!-- SUMMARY CARDS -->

    <section class="summary-grid">
        <article class="summary-card dashboard-balance-card">
            <p>
                Current Balance
            </p>

            <h2>
                <%= formatMoney(currentBalance) %>
            </h2>

            <span>
                Total income minus total expenses
            </span>
        </article>

        <article class="summary-card">
            <p>
                Monthly Income
            </p>

            <h2>
                <%= formatMoney(monthlyIncome) %>
            </h2>

            <span>
                Income received this month
            </span>
        </article>

        <article class="summary-card">
            <p>
                Monthly Expenses
            </p>

            <h2>
                <%= formatMoney(monthlyExpenses) %>
            </h2>

            <span>
                Expenses recorded this month
            </span>
        </article>

        <article class="summary-card">
            <p>
                Safe Available Balance
            </p>

            <h2>
                <%= formatMoney(safeAvailableBalance) %>
            </h2>

            <span>
                After payments due within 30 days
            </span>
        </article>
    </section>

    <!-- MAIN DASHBOARD GRID -->

    <section class="dashboard-grid">

        <!-- RECENT TRANSACTIONS -->

        <article class="dashboard-panel spending-panel">
            <div class="panel-heading">
                <h2>
                    Recent Transactions
                </h2>

                <a href="/transactions">
                    View all
                </a>
            </div>

            <% if (recentTransactions.length > 0) { %>

                <div class="payment-list">

                    <% recentTransactions.forEach((transaction) => { %>

                        <div class="payment-item">
                            <span class="payment-icon">
                                <%= transaction.type === "income"
                                    ? "+"
                                    : "−"
                                %>
                            </span>

                            <div class="payment-details">
                                <strong>
                                    <%= transaction.title %>
                                </strong>

                                <span>
                                    <%= transaction.category %>
                                    ·
                                    <%= formatDate(
                                        transaction.transaction_date
                                    ) %>
                                </span>
                            </div>

                            <strong>
                                <%= transaction.type === "income"
                                    ? "+"
                                    : "−"
                                %><%= formatMoney(
                                    transaction.amount
                                ) %>
                            </strong>
                        </div>
                    <% }) %>
                </div>

            <% } else { %>

                <div class="empty-state">
                    <h3>
                        No transactions yet
                    </h3>

                    <p>
                        Add your first income or expense to begin
                        building your financial overview.
                    </p>

                    <a
                        href="/transactions"
                        class="primary-button"
                    >
                        Add Transaction
                    </a>
                </div>
            <% } %>
        </article>

        <!-- UPCOMING PAYMENTS -->

        <article class="dashboard-panel upcoming-panel">

            <div class="panel-heading">
                <h2>
                    Upcoming Payments
                </h2>

                <a href="/payments">
                    Manage
                </a>
            </div>

            <% if (upcomingPayments.length > 0) { %>

                <div class="payment-list">

                    <% upcomingPayments.forEach((payment) => { %>

                        <div class="payment-item">
                            <span class="payment-icon">
                                £
                            </span>

                            <div class="payment-details">
                                <strong>
                                    <%= payment.name %>
                                </strong>

                                <span>
                                    <%= payment.category %>
                                    ·
                                    <%= formatDate(
                                        payment.next_payment_date
                                    ) %>
                                </span>
                            </div>

                            <strong>
                                <%= formatMoney(payment.amount) %>
                            </strong>
                        </div>
                    <% }) %>
                </div>

                <div class="upcoming-summary">
                    <span>
                        Due within 30 days
                    </span>

                    <strong>
                        <%= formatMoney(upcomingTotal) %>
                    </strong>
                </div>

                <div class="balance-after">
                    Safe balance after upcoming payments:

                    <strong>
                        <%= formatMoney(
                            safeAvailableBalance
                        ) %>
                    </strong>
                </div>

            <% } else { %>

                <div class="empty-state">
                    <h3>
                        No upcoming payments
                    </h3>

                    <p>
                        Add recurring bills and subscriptions to
                        see what is due next.
                    </p>

                    <a
                        href="/payments"
                        class="primary-button"
                    >
                        Add Payment
                    </a>
                </div>
            <% } %>
        </article>

        <!-- FINANCIAL FORECAST -->

        <article class="dashboard-panel forecast-panel">

            <div class="panel-heading">
                <h2>
                    Monthly Position
                </h2>

                <span>
                    This month
                </span>
            </div>

            <div class="savings-predictions">
                <div>
                    <span>
                        Income
                    </span>

                    <strong>
                        <%= formatMoney(monthlyIncome) %>
                    </strong>
                </div>

                <div>
                    <span>
                        Expenses
                    </span>

                    <strong>
                        <%= formatMoney(monthlyExpenses) %>
                    </strong>
                </div>

                <div>
                    <span>
                        Monthly Difference
                    </span>

                    <strong>
                        <%= formatMoney(
                            monthlyIncome - monthlyExpenses
                        ) %>
                    </strong>
                </div>

                <div>
                    <span>
                        Upcoming Commitments
                    </span>

                    <strong>
                        <%= formatMoney(upcomingTotal) %>
                    </strong>
                </div>
            </div>

            <div class="balance-after">
                Your current safe available balance is

                <strong>
                    <%= formatMoney(safeAvailableBalance) %>
                </strong>
            </div>
        </article>

        <!-- SAVINGS -->

        <article class="dashboard-panel savings-panel">
            <div class="panel-heading">
                <h2>
                    Savings Progress
                </h2>

                <a href="/savings">
                    View goals
                </a>
            </div>

            <% if (savingsGoals.length > 0) { %>

                <div class="savings-value">
                    <strong>
                        <%= formatMoney(totalSavings) %>
                    </strong>

                    <span>
                        of
                        <%= formatMoney(totalSavingsTarget) %>
                    </span>
                </div>

                <div
                    class="progress-track"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="<%= savingsPercentage %>"
                    aria-label="Overall savings progress"
                >
                    <div
                        class="progress-value"
                        data-progress="<%= savingsPercentage %>"
                    ></div>
                </div>

                <div class="savings-predictions">

                    <div>
                        <span>
                            Progress
                        </span>

                        <strong>
                            <%= savingsPercentage %>%
                        </strong>
                    </div>

                    <div>
                        <span>
                            Active Goals
                        </span>

                        <strong>
                            <%= savingsGoals.length %>
                        </strong>
                    </div>

                </div>

            <% } else { %>

                <div class="empty-state">
                    <h3>
                        No savings goals
                    </h3>

                    <p>
                        Create a goal and track your progress
                        towards it.
                    </p>

                    <a
                        href="/savings"
                        class="primary-button"
                    >
                        Create Goal
                    </a>
                </div>
            <% } %>
        </article>
    </section>
</main>

<script>
    const progressBar = document.querySelector(".progress-value");

    if (progressBar) {
        const progress =
            Number(progressBar.dataset.progress) || 0;

        progressBar.style.width = `${progress}%`;
    }
</script>

<script src="/js/intro.js"></script>

<%- include("partials/footer") %>