<%- include("partials/header") %>

<%- include("partials/navigation") %>

<%
    function formatMoney(value) {
        return new Intl.NumberFormat("en-GB", {
            style: "currency",
            currency: "GBP"
        }).format(Number(value) || 0);
    }

    function formatDate(value) {
        if (!value) {
            return "No date";
        }

        return new Intl.DateTimeFormat("en-GB", {
            day: "numeric",
            month: "short",
            year: "numeric"
        }).format(new Date(`${value}T00:00:00`));
    }

    function formatFrequency(value) {
        return value
            ? value.charAt(0).toUpperCase() + value.slice(1)
            : "";
    }
%>

<main class="payments-page">

    <section class="payments-hero">
        <div>
            <p class="section-label">
                Recurring Bills Manager
            </p>

            <h1>
                Payments
            </h1>

            <p>
                Add your regular bills once and MoneyMap will
                calculate your committed monthly outgoings.
            </p>
        </div>
    </section>

    <% if (paymentAdded) { %>
        <div class="payments-message success-message">
            Recurring payment added successfully.
        </div>
    <% } %>

    <% if (paymentDeleted) { %>
        <div class="payments-message success-message">
            Recurring payment deleted.
        </div>
    <% } %>

    <% if (paymentUpdated) { %>
        <div class="payments-message success-message">
            Payment status updated.
        </div>
    <% } %>

    <% if (formError) { %>
        <div class="payments-message error-message">
            <%= formError %>
        </div>
    <% } %>

    <section class="payments-summary">

        <article class="payment-summary-card featured">
            <span>Monthly committed bills</span>

            <strong>
                <%= formatMoney(monthlyTotal) %>
            </strong>

            <p>
                Estimated average monthly cost
            </p>
        </article>

        <article class="payment-summary-card">
            <span>Annual recurring cost</span>

            <strong>
                <%= formatMoney(yearlyTotal) %>
            </strong>

            <p>
                Estimated total across one year
            </p>
        </article>

        <article class="payment-summary-card">
            <span>Active payments</span>

            <strong>
                <%= payments.filter(payment => payment.is_active === 1).length %>
            </strong>

            <p>
                Bills currently included
            </p>
        </article>

    </section>

    <section class="payments-layout">

        <section class="add-payment-panel">

            <div class="section-heading">
                <div>
                    <p class="section-label">
                        Add a regular expense
                    </p>

                    <h2>
                        New Recurring Payment
                    </h2>
                </div>
            </div>

            <form
                action="/payments"
                method="POST"
                class="payment-form"
            >

                <div class="form-group">
                    <label for="name">
                        Payment name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= formData.name || "" %>"
                        placeholder="Example: Rent"
                        required
                    >
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label for="amount">
                            Amount
                        </label>

                        <input
                            type="number"
                            id="amount"
                            name="amount"
                            value="<%= formData.amount || "" %>"
                            min="0.01"
                            step="0.01"
                            placeholder="0.00"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="category">
                            Category
                        </label>

                        <select
                            id="category"
                            name="category"
                            required
                        >
                            <option value="">
                                Select category
                            </option>

                            <% categories.forEach(category => { %>
                                <option
                                    value="<%= category.name %>"
                                    <%= formData.category === category.name
                                        ? "selected"
                                        : "" %>
                                >
                                    <%= category.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label for="frequency">
                            Frequency
                        </label>

                        <select
                            id="frequency"
                            name="frequency"
                            required
                        >
                            <option value="">
                                Select frequency
                            </option>

                            <option
                                value="weekly"
                                <%= formData.frequency === "weekly"
                                    ? "selected"
                                    : "" %>
                            >
                                Weekly
                            </option>

                            <option
                                value="monthly"
                                <%= formData.frequency === "monthly"
                                    ? "selected"
                                    : "" %>
                            >
                                Monthly
                            </option>

                            <option
                                value="quarterly"
                                <%= formData.frequency === "quarterly"
                                    ? "selected"
                                    : "" %>
                            >
                                Quarterly
                            </option>

                            <option
                                value="yearly"
                                <%= formData.frequency === "yearly"
                                    ? "selected"
                                    : "" %>
                            >
                                Yearly
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="nextPaymentDate">
                            Next payment date
                        </label>

                        <input
                            type="date"
                            id="nextPaymentDate"
                            name="nextPaymentDate"
                            value="<%= formData.nextPaymentDate || "" %>"
                            required
                        >
                    </div>

                </div>

                <div class="form-group">
                    <label for="reminderDays">
                        Reminder days before payment
                    </label>

                    <input
                        type="number"
                        id="reminderDays"
                        name="reminderDays"
                        value="<%= formData.reminderDays || 7 %>"
                        min="0"
                        max="30"
                    >
                </div>

                <button
                    type="submit"
                    class="primary-button"
                >
                    Add Recurring Payment
                </button>

            </form>

        </section>

        <aside class="category-breakdown-panel">

            <div class="section-heading">
                <div>
                    <p class="section-label">
                        Where your money goes
                    </p>

                    <h2>
                        Category Breakdown
                    </h2>
                </div>
            </div>

            <% if (categoryTotals.length === 0) { %>
                <p class="empty-state">
                    Add recurring payments to see your category totals.
                </p>
            <% } else { %>

                <div class="category-breakdown-list">

                    <% categoryTotals.forEach(item => { %>
                        <div class="category-breakdown-item">

                            <div>
                                <strong>
                                    <%= item.category %>
                                </strong>

                                <span>
                                    Monthly estimate
                                </span>
                            </div>

                            <strong>
                                <%= formatMoney(item.monthly_total) %>
                            </strong>

                        </div>
                    <% }) %>

                </div>

            <% } %>

        </aside>

    </section>

    <section class="recurring-payments-section">

        <div class="section-heading">
            <div>
                <p class="section-label">
                    Your regular commitments
                </p>

                <h2>
                    Recurring Payments
                </h2>
            </div>
        </div>

        <% if (payments.length === 0) { %>

            <div class="empty-state payment-empty-state">
                <h3>No recurring payments yet</h3>

                <p>
                    Add rent, utilities, school costs,
                    subscriptions, insurance or any other
                    repeated expense.
                </p>
            </div>

        <% } else { %>

            <div class="payments-table-wrapper">

                <table class="payments-table">

                    <thead>
                        <tr>
                            <th>Payment</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Frequency</th>
                            <th>Next payment</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% payments.forEach(payment => { %>

                            <tr class="<%= payment.is_active === 1
                                ? ""
                                : "inactive-payment" %>">

                                <td>
                                    <strong>
                                        <%= payment.name %>
                                    </strong>

                                    <span>
                                        Reminder:
                                        <%= payment.reminder_days %>
                                        day<%= payment.reminder_days === 1
                                            ? ""
                                            : "s" %> before
                                    </span>
                                </td>

                                <td>
                                    <span class="category-badge">
                                        <%= payment.category %>
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        <%= formatMoney(payment.amount) %>
                                    </strong>
                                </td>

                                <td>
                                    <%= formatFrequency(payment.frequency) %>
                                </td>

                                <td>
                                    <%= formatDate(payment.next_payment_date) %>
                                </td>

                                <td>
                                    <span class="status-badge <%= payment.is_active === 1
                                        ? "active"
                                        : "inactive" %>">
                                        <%= payment.is_active === 1
                                            ? "Active"
                                            : "Paused" %>
                                    </span>
                                </td>

                                <td>
                                    <div class="payment-actions">

                                        <form
                                            action="/payments/<%= payment.id %>/toggle"
                                            method="POST"
                                        >
                                            <button
                                                type="submit"
                                                class="secondary-button"
                                            >
                                                <%= payment.is_active === 1
                                                    ? "Pause"
                                                    : "Activate" %>
                                            </button>
                                        </form>

                                        <form
                                            action="/payments/<%= payment.id %>/delete"
                                            method="POST"
                                            onsubmit="return confirm('Delete this recurring payment?');"
                                        >
                                            <button
                                                type="submit"
                                                class="danger-button"
                                            >
                                                Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </section>

</main>

<%- include("partials/footer") %>